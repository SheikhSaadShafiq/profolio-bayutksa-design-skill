 "decisions": [
  {
   "what": "The product shell is kept",
   "how": "every screen (136 of 136) draws the product's own header and rail in place of the handover's (scripts/theme/shell.mjs); the new theme is measured without them"
  },
  {
   "what": "The riyal is a glyph",
   "how": "\"SAR\" written out became the build's own riyal glyph in 160 places across 74 states"
  },
  {
   "what": "The drawer is 780px",
   "how": "both builds draw the Listing Performance drawer 780 wide (spec 02b agrees); 03 · F’s 680 is the Quality Score drawer’s width"
